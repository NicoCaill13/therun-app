# API Configuration (production: https://api.runningparty.run)
# Include path prefix if your backend uses one (e.g. /api -> POST /api/events):
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.36:3000/api
EXPO_PUBLIC_API_BASE_URL=
# App Configuration (production: runningparty.run)
EXPO_PUBLIC_APP_SCHEME=
EXPO_PUBLIC_WEB_DOMAIN=
# Auth paths (therun API: only user/register; no login endpoint yet)
# EXPO_PUBLIC_AUTH_REGISTER_PATH=user/register
# EXPO_PUBLIC_AUTH_LOGIN_PATH=user/login
# Optional: development | staging | production
EXPO_PUBLIC_ENV_NAME=
